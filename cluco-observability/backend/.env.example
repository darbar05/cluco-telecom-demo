# Cluco Observability Backend (MongoDB)
# Copy to .env and fill in your values

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cluco_observability

# Server
PORT=9410

# OpenAI (for LLM-as-a-Judge, AI assistant, prompt optimization)
OPENAI_API_KEY=your-openai-api-key-here

# SMTP (Gmail example — use an App Password, not your regular password)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Cluco Observability
SMTP_USE_TLS=true
