# LECO (legal product) — minimal config for Cluco Observability
# Copy to .env or set in your environment

AGENT_OBS_ENABLED=true
AGENT_OBS_PRODUCT_ID=leco
AGENT_OBS_SERVICE_NAME=leco-legal-agent
AGENT_OBS_EXPORTER=http
AGENT_OBS_BACKEND_URL=http://localhost:9410
AGENT_OBS_BACKEND_PATH=/api/v1/traces

# Optional: OpenTelemetry OTLP (pip install agent-observability[otel])
# AGENT_OBS_OTEL_ENABLED=true
# AGENT_OBS_OTEL_ENDPOINT=http://localhost:4318/v1/traces
